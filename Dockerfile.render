# Ursina 3D rendered benchmark — software OpenGL via Xvfb + Mesa
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DISPLAY=:99 \
    MESA_GL_VERSION_OVERRIDE=3.3 \
    LIBGL_ALWAYS_SOFTWARE=1

# Install Xvfb, Mesa (software GL), and OpenGL libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    mesa-utils \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir numpy scipy psutil ursina

WORKDIR /app
COPY . .
RUN mkdir -p /app/benchmarks

# Start Xvfb, then run benchmark
CMD Xvfb :99 -screen 0 1024x768x24 -ac +extension GLX +render -noreset & \
    sleep 2 && \
    python3 headless_bench_3d.py
