# Docker environment configuration for Drone Swarm Simulation (CPU-Only)
# Copy to .env and customize for your system

# Display settings (for GUI mode)
DISPLAY=:0

# CPU Configuration
CPU_CORES=3
CPU_MEMORY_MB=2048

# Ray Distributed Computing (CPU-optimized)
RAY_memory=1000000000
RAY_object_store_memory=500000000
RAY_num_cpus=3

# Container Resource Limits
CONTAINER_MEM_LIMIT=2g
CONTAINER_CPUS=3
CONTAINER_CPUSET_CPUS=

# Simulation Parameters
NUM_DRONES=100
PERCEPTION_RADIUS=50
MAX_SPEED=250
MAX_FORCE=5.0

# Benchmark Configuration
BENCHMARK_DURATION=60
BENCHMARK_HEADLESS=1

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
BENCHMARK_DIR=benchmarks
RESULTS_DIR=results

# Docker Build
DOCKER_BUILDKIT=1
BUILDKIT_PROGRESS=plain
